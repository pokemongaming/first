<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<title>
Mr. Rime Pokémon GO Guide — Stats, Max CP, Moves, IVs, Shiny, Shadow, Lucky, XXL & XXS
</title>

<meta name="description"
      content="Complete Mr. Rime Pokémon GO guide covering regular, shiny, shadow, purified, lucky, 100% IV, XXL and XXS Mr. Rime, including stats, Max CP, weaknesses, resistances, moves, PvE, PvP, evolution and availability.">

<meta name="robots"
      content="index, follow">

<link rel="canonical"
      href="https://pokemongaming.in/pokemon/mr-rime.html">


<style>

/* =========================================================
   ROOT
========================================================= */

:root {

    --bg: #080b12;
    --bg-soft: #0e131d;
    --surface: #121925;
    --surface-2: #171f2d;
    --surface-3: #202a3b;

    --border: #293448;

    --text: #f4f6fb;
    --muted: #aab3c2;

    --accent: #8fdff0;
    --accent-2: #63c9df;

    --ice: #72d6dc;
    --psychic: #d783e8;

    --danger: #ff6f7d;
    --success: #62d89a;
    --gold: #f0c75e;
    --shadow: #9b6cff;

    --radius: 18px;
    --radius-sm: 12px;

    --max: 1200px;
}


/* =========================================================
   RESET
========================================================= */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {

    font-family:
        Inter,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

    background:

        radial-gradient(
            circle at 85% 0%,
            rgba(114,214,220,.12),
            transparent 30%
        ),

        radial-gradient(
            circle at 10% 20%,
            rgba(215,131,232,.06),
            transparent 25%
        ),

        var(--bg);

    color: var(--text);

    line-height: 1.7;
}

img {
    max-width: 100%;
    display: block;
}

a {
    color: inherit;
    text-decoration: none;
}

p {
    color: var(--muted);
    margin-bottom: 14px;
}

h1,
h2,
h3,
h4 {
    line-height: 1.25;
}

table {
    width: 100%;
    border-collapse: collapse;
}


/* =========================================================
   HEADER
========================================================= */

.site-header {

    position: sticky;
    top: 0;
    z-index: 100;

    background:
        rgba(8,11,18,.94);

    backdrop-filter:
        blur(15px);

    border-bottom:
        1px solid var(--border);
}

.header-inner {

    max-width: var(--max);

    margin: auto;

    min-height: 68px;

    padding: 0 20px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;
}

.logo {

    font-size: 1.15rem;

    font-weight: 950;

    letter-spacing: -.03em;
}

.logo span {
    color: var(--accent);
}

.main-nav {

    display: flex;

    gap: 20px;

    flex-wrap: wrap;
}

.main-nav a {

    color: var(--muted);

    font-size: .8rem;

    font-weight: 750;
}

.main-nav a:hover {
    color: white;
}


/* =========================================================
   PAGE
========================================================= */

.page {

    max-width: var(--max);

    margin: auto;

    padding:
        35px 20px 80px;
}


/* =========================================================
   BREADCRUMB
========================================================= */

.breadcrumb {

    display: flex;

    flex-wrap: wrap;

    gap: 8px;

    margin-bottom: 25px;

    color: var(--muted);

    font-size: .72rem;
}

.breadcrumb span {
    opacity: .5;
}

.breadcrumb a:hover {
    color: white;
}


/* =========================================================
   HERO
========================================================= */

.pokemon-hero {

    position: relative;

    overflow: hidden;

    padding: 34px;

    border:
        1px solid var(--border);

    border-radius: 26px;

    background:

        radial-gradient(
            circle at 85% 15%,
            rgba(114,214,220,.17),
            transparent 30%
        ),

        radial-gradient(
            circle at 15% 90%,
            rgba(215,131,232,.09),
            transparent 30%
        ),

        linear-gradient(
            145deg,
            #111827,
            #0c111b
        );

    box-shadow:
        0 25px 70px rgba(0,0,0,.25);
}

.hero-grid {

    display: grid;

    grid-template-columns:
        1.35fr .65fr;

    gap: 30px;

    align-items: center;
}

.eyebrow {

    display: inline-flex;

    padding: 6px 10px;

    border:
        1px solid rgba(114,214,220,.3);

    border-radius: 999px;

    color: var(--ice);

    background:
        rgba(114,214,220,.08);

    font-size: .68rem;

    font-weight: 900;

    letter-spacing: .08em;

    margin-bottom: 14px;
}

.pokemon-hero h1 {

    font-size:
        clamp(2.2rem,5vw,4.5rem);

    letter-spacing: -.055em;

    margin-bottom: 12px;
}

.hero-subtitle {

    max-width: 730px;

    font-size: 1rem;

    color: #c2cad7;
}

.hero-tags {

    display: flex;

    flex-wrap: wrap;

    gap: 8px;

    margin-top: 20px;
}

.tag {

    padding:
        7px 11px;

    border:
        1px solid var(--border);

    border-radius: 999px;

    background:
        rgba(255,255,255,.035);

    font-size: .7rem;

    font-weight: 800;
}

.ice-tag {
    color: var(--ice);
}

.psychic-tag {
    color: var(--psychic);
}


/* =========================================================
   HERO POKEMON
========================================================= */

.hero-pokemon {

    min-height: 300px;

    display: flex;

    justify-content: center;

    align-items: center;
}

.pokemon-placeholder {

    width: 260px;

    height: 260px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 50%;

    background:

        radial-gradient(
            circle,
            rgba(114,214,220,.18),
            transparent 65%
        );

    font-size: 7rem;

    filter:
        drop-shadow(
            0 20px 25px rgba(0,0,0,.4)
        );
}


/* =========================================================
   QUICK STATS
========================================================= */

.quick-stats {

    display: grid;

    grid-template-columns:
        repeat(4,1fr);

    gap: 12px;

    margin-top: 18px;
}

.quick-stat {

    padding: 18px;

    background:
        var(--surface);

    border:
        1px solid var(--border);

    border-radius:
        var(--radius-sm);

    text-align: center;
}

.quick-stat strong {

    display: block;

    font-size: 1.25rem;
}

.quick-stat span {

    color: var(--muted);

    font-size: .68rem;

    font-weight: 750;
}


/* =========================================================
   LAYOUT
========================================================= */

.content-layout {

    display: grid;

    grid-template-columns:
        minmax(0,1fr) 290px;

    gap: 20px;

    margin-top: 20px;
}


/* =========================================================
   SECTION
========================================================= */

.section {

    margin-bottom: 20px;

    padding: 28px;

    background:
        var(--surface);

    border:
        1px solid var(--border);

    border-radius:
        var(--radius);
}

.section-heading {
    margin-bottom: 20px;
}

.section-kicker {

    display: block;

    margin-bottom: 6px;

    color: var(--accent);

    font-size: .68rem;

    font-weight: 900;

    letter-spacing: .08em;
}

.section h2 {

    font-size:
        clamp(1.45rem,3vw,2rem);

    margin-bottom: 9px;
}

.section h3 {

    margin:
        22px 0 10px;

    font-size: 1.05rem;
}


/* =========================================================
   STAT GRID
========================================================= */

.stat-grid {

    display: grid;

    grid-template-columns:
        repeat(4,1fr);

    gap: 10px;
}

.stat-card {

    padding: 17px;

    background:
        var(--surface-2);

    border:
        1px solid var(--border);

    border-radius:
        var(--radius-sm);
}

.stat-card span {

    display: block;

    color: var(--muted);

    font-size: .64rem;

    font-weight: 850;

    letter-spacing: .04em;
}

.stat-card strong {

    display: block;

    margin-top: 4px;

    font-size: 1.5rem;
}


/* =========================================================
   TYPE BOX
========================================================= */

.type-box {

    display: flex;

    align-items: center;

    gap: 15px;

    padding: 18px;

    border:
        1px solid rgba(114,214,220,.3);

    background:
        rgba(114,214,220,.06);

    border-radius:
        var(--radius-sm);
}

.type-icon {

    width: 50px;

    height: 50px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 14px;

    background:
        rgba(114,214,220,.13);

    font-size: 1.5rem;
}

.type-box strong {
    display: block;
}

.type-box span {

    color: var(--ice);

    font-size: .75rem;

    font-weight: 850;
}


/* =========================================================
   EFFECT GRID
========================================================= */

.effect-grid {

    display: grid;

    grid-template-columns:
        repeat(3,1fr);

    gap: 12px;

    margin-top: 15px;
}

.effect-card {

    padding: 17px;

    border:
        1px solid var(--border);

    border-radius:
        var(--radius-sm);

    background:
        var(--surface-2);
}

.effect-card .effect-icon {

    font-size: 1.5rem;

    margin-bottom: 6px;
}

.effect-card strong {
    display: block;
}

.effect-card span {

    color: var(--muted);

    font-size: .7rem;
}

.weakness {
    border-color:
        rgba(255,111,125,.25);
}

.resistance {
    border-color:
        rgba(98,216,154,.25);
}


/* =========================================================
   MOVE TABLE
========================================================= */

.table-wrap {
    overflow-x: auto;
}

.data-table th,
.data-table td {

    padding:
        13px 12px;

    border-bottom:
        1px solid var(--border);

    text-align: left;

    font-size: .76rem;
}

.data-table th {

    color: var(--muted);

    font-size: .65rem;

    text-transform: uppercase;

    letter-spacing: .05em;
}

.move-name {
    font-weight: 850;
}

.move-type {

    color: var(--ice);

    font-weight: 800;
}


/* =========================================================
   FEATURE CARD
========================================================= */

.feature-card {

    margin-top: 15px;

    padding: 20px;

    background:

        linear-gradient(
            135deg,
            rgba(114,214,220,.10),
            rgba(215,131,232,.05)
        );

    border:
        1px solid rgba(114,214,220,.25);

    border-radius:
        var(--radius-sm);
}

.feature-card strong {

    display: block;

    margin-bottom: 5px;
}


/* =========================================================
   FORM / VARIANT GRID
========================================================= */

.variant-grid {

    display: grid;

    grid-template-columns:
        repeat(3,1fr);

    gap: 14px;

    margin-top: 20px;
}

.variant-card {

    padding: 20px;

    border:
        1px solid var(--border);

    border-radius: 16px;

    background:
        var(--surface-2);

    transition:
        transform .2s ease,
        border-color .2s ease;
}

.variant-card:hover {

    transform:
        translateY(-3px);

    border-color:
        rgba(114,214,220,.4);
}

.variant-icon {

    font-size: 2rem;

    margin-bottom: 10px;
}

.variant-card strong {

    display: block;

    font-size: 1rem;

    margin-bottom: 5px;
}

.variant-card p {

    font-size: .75rem;

    margin-bottom: 0;
}


/* =========================================================
   SPECIAL FORM COLORS
========================================================= */

.shiny-card {
    border-color:
        rgba(240,199,94,.35);
}

.shadow-card {
    border-color:
        rgba(155,108,255,.35);
}

.lucky-card {
    border-color:
        rgba(240,199,94,.45);
}

.purified-card {
    border-color:
        rgba(98,216,154,.35);
}

.hundo-card {
    border-color:
        rgba(255,255,255,.28);
}

.size-card {
    border-color:
        rgba(114,214,220,.35);
}


/* =========================================================
   COMPARISON
========================================================= */

.comparison-table {

    width: 100%;

    min-width: 700px;
}

.comparison-table th,
.comparison-table td {

    padding: 14px;

    border:
        1px solid var(--border);

    font-size: .75rem;
}

.comparison-table th {

    background:
        var(--surface-2);

    text-align: left;
}


/* =========================================================
   IV CARDS
========================================================= */

.iv-grid {

    display: grid;

    grid-template-columns:
        repeat(3,1fr);

    gap: 10px;

    margin-top: 15px;
}

.iv-card {

    padding: 20px;

    background:
        var(--surface-2);

    border:
        1px solid var(--border);

    border-radius:
        var(--radius-sm);

    text-align: center;
}

.iv-card strong {

    display: block;

    font-size: 1.5rem;
}

.iv-card span {

    color: var(--muted);

    font-size: .68rem;
}


/* =========================================================
   SIZE CARD
========================================================= */

.size-panel {

    display: grid;

    grid-template-columns:
        repeat(2,1fr);

    gap: 15px;

    margin-top: 20px;
}

.size-box {

    padding: 25px;

    border-radius: 18px;

    background:
        var(--surface-2);

    border:
        1px solid var(--border);
}

.size-box .size-symbol {

    font-size: 2.3rem;

    display: block;

    margin-bottom: 8px;
}

.size-box strong {

    display: block;

    font-size: 1.2rem;
}

.size-box span {

    color: var(--muted);

    font-size: .75rem;
}


/* =========================================================
   RATING
========================================================= */

.rating-row {

    display: grid;

    grid-template-columns:
        170px 1fr 70px;

    gap: 15px;

    align-items: center;

    padding: 12px 0;

    border-bottom:
        1px solid var(--border);
}

.rating-row:last-child {
    border-bottom: 0;
}

.rating-bar {

    height: 8px;

    background:
        var(--surface-3);

    border-radius: 99px;

    overflow: hidden;
}

.rating-fill {

    height: 100%;

    width: var(--rating);

    background:
        linear-gradient(
            90deg,
            var(--accent),
            var(--psychic)
        );

    border-radius: inherit;
}

.rating-value {

    text-align: right;

    font-weight: 900;
}


/* =========================================================
   CHECKLIST
========================================================= */

.checklist {

    list-style: none;

    display: grid;

    gap: 8px;

    margin-top: 15px;
}

.checklist li {

    padding:
        12px 14px;

    background:
        var(--surface-2);

    border:
        1px solid var(--border);

    border-radius: 9px;

    color: #c8cfda;

    font-size: .78rem;
}

.checklist li::before {

    content: "✓";

    margin-right: 8px;

    color: var(--success);

    font-weight: 900;
}


/* =========================================================
   EDITORIAL NOTE
========================================================= */

.editorial-note {

    padding: 17px;

    margin-top: 20px;

    background:
        rgba(255,255,255,.025);

    border:
        1px solid var(--border);

    border-radius:
        var(--radius-sm);

    font-size: .72rem;
}

.editorial-note strong {
    display: block;
    margin-bottom: 5px;
}


/* =========================================================
   SIDEBAR
========================================================= */

.sidebar {

    position: sticky;

    top: 88px;

    align-self: start;
}

.side-card {

    margin-bottom: 15px;

    padding: 20px;

    background:
        var(--surface);

    border:
        1px solid var(--border);

    border-radius:
        var(--radius);
}

.side-card h3 {

    margin:
        0 0 13px;

    font-size: .9rem;
}

.side-nav {

    list-style: none;

    display: grid;

    gap: 4px;
}

.side-nav a {

    display: block;

    padding:
        8px 10px;

    border-radius: 7px;

    color: var(--muted);

    font-size: .72rem;

    font-weight: 700;
}

.side-nav a:hover {

    background:
        var(--surface-2);

    color: white;
}

.related-link {

    display: block;

    padding: 10px 0;

    border-bottom:
        1px solid var(--border);

    color: var(--muted);

    font-size: .75rem;
}

.related-link:last-child {
    border-bottom: 0;
}

.related-link:hover {
    color: var(--accent);
}


/* =========================================================
   FAQ
========================================================= */

details {

    padding: 15px 0;

    border-bottom:
        1px solid var(--border);
}

details:last-child {
    border-bottom: 0;
}

summary {

    cursor: pointer;

    font-weight: 850;

    font-size: .82rem;
}

details p {

    margin:
        10px 0 0;

    font-size: .78rem;
}


/* =========================================================
   FOOTER
========================================================= */

footer {

    border-top:
        1px solid var(--border);

    padding:
        35px 20px;

    background:
        #06090e;
}

.footer-inner {

    max-width: var(--max);

    margin: auto;

    display: flex;

    justify-content: space-between;

    gap: 20px;

    flex-wrap: wrap;
}

footer p {

    margin: 0;

    font-size: .72rem;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:950px) {

    .content-layout {
        grid-template-columns: 1fr;
    }

    .sidebar {
        position: static;
    }

    .hero-grid {
        grid-template-columns: 1fr;
    }

    .hero-pokemon {
        order: -1;
    }

    .stat-grid {
        grid-template-columns:
            repeat(2,1fr);
    }

    .variant-grid {
        grid-template-columns:
            repeat(2,1fr);
    }
}


@media(max-width:650px) {

    .page {
        padding:
            22px 13px 60px;
    }

    .pokemon-hero,
    .section {
        padding: 20px;
    }

    .quick-stats {
        grid-template-columns:
            repeat(2,1fr);
    }

    .effect-grid {
        grid-template-columns: 1fr;
    }

    .stat-grid {
        grid-template-columns:
            repeat(2,1fr);
    }

    .iv-grid {
        grid-template-columns: 1fr;
    }

    .variant-grid {
        grid-template-columns: 1fr;
    }

    .size-panel {
        grid-template-columns: 1fr;
    }

    .rating-row {
        grid-template-columns: 1fr;

        gap: 6px;
    }

    .rating-value {
        text-align: left;
    }

    .main-nav {
        display: none;
    }
}

</style>

</head>


<body>


<!-- =====================================================
     HEADER
===================================================== -->

<header class="site-header">

    <div class="header-inner">

        <a href="/" class="logo">
            Pokémon<span>Gaming</span>
        </a>

        <nav class="main-nav">

            <a href="/pokemon-types.html">
                Types
            </a>

            <a href="/pokedex.html">
                Pokédex
            </a>

            <a href="/raids/">
                Raids
            </a>

            <a href="/guides/">
                Guides
            </a>

            <a href="/tools/">
                Tools
            </a>

        </nav>

    </div>

</header>


<!-- =====================================================
     MAIN
===================================================== -->

<main class="page">


<!-- =====================================================
     BREADCRUMB
===================================================== -->

<div class="breadcrumb">

    <a href="/">
        Home
    </a>

    <span>›</span>

    <a href="/pokedex.html">
        Pokémon Database
    </a>

    <span>›</span>

    <a href="/pokemon-types/ice.html">
        Ice Type
    </a>

    <span>›</span>

    <strong>
        Mr. Rime
    </strong>

</div>


<!-- =====================================================
     HERO
===================================================== -->

<section class="pokemon-hero">

    <div class="hero-grid">

        <div>

            <span class="eyebrow">
                Galarian Evolution • #866
            </span>

            <h1>
                Mr. Rime
            </h1>

            <p class="hero-subtitle">

                Mr. Rime is a dual Ice/Psychic-type Pokémon
                that evolves from Galarian Mr. Mime. In
                Pokémon GO, it can be found in regular, shiny,
                Shadow, purified, Lucky, XXS and XXL variants,
                making it an interesting addition to a complete
                Pokémon collection.

            </p>

            <div class="hero-tags">

                <span class="tag ice-tag">
                    Ice
                </span>

                <span class="tag psychic-tag">
                    Psychic
                </span>

                <span class="tag">
                    #866
                </span>

                <span class="tag">
                    Gen 8
                </span>

                <span class="tag">
                    Shiny Available
                </span>

            </div>

        </div>


        <div class="hero-pokemon">

            <!-- Replace with your own properly licensed image -->

            <div class="pokemon-placeholder">
                🎩
            </div>

        </div>

    </div>

</section>


<!-- =====================================================
     QUICK STATS
===================================================== -->

<div class="quick-stats">

    <div class="quick-stat">

        <strong>
            212
        </strong>

        <span>
            ATTACK
        </span>

    </div>


    <div class="quick-stat">

        <strong>
            179
        </strong>

        <span>
            DEFENSE
        </span>

    </div>


    <div class="quick-stat">

        <strong>
            190
        </strong>

        <span>
            HP
        </span>

    </div>


    <div class="quick-stat">

        <strong>
            3,196
        </strong>

        <span>
            MAX CP
        </span>

    </div>

</div>


<!-- =====================================================
     CONTENT
===================================================== -->

<div class="content-layout">


<div class="main-content">


<!-- =====================================================
     01 OVERVIEW
===================================================== -->

<section class="section" id="overview">

    <div class="section-heading">

        <span class="section-kicker">
            01 • DATABASE
        </span>

        <h2>
            Mr. Rime Overview
        </h2>

        <p>

            Mr. Rime is a dual-type Ice and Psychic Pokémon
            originally introduced in Generation 8. In Pokémon GO,
            it evolves from Galarian Mr. Mime using 50 Candy.

        </p>

    </div>


    <div class="stat-grid">

        <div class="stat-card">

            <span>
                POKÉDEX
            </span>

            <strong>
                #866
            </strong>

        </div>


        <div class="stat-card">

            <span>
                GENERATION
            </span>

